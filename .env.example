# LLM Configuration
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=us-east-1-aws

# Database Connection (defaults to local DuckDB/SQLite if not specified)
DB_TYPE=duckdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sample_db
DB_USER=readonly_user
DB_PASSWORD=
DB_PATH=data/chinook.db
DB_TIMEOUT=30

# Application Settings
MAX_RETRIES=3
SCHEMA_CACHE_ENABLED=true
HUMAN_IN_LOOP_ENABLED=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Service mode (API). Not needed for the Streamlit app.
# ---------------------------------------------------------------------------
# Fernet key that encrypts stored database credentials. Required when the metadata
# store is persistent. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first and keep the old one after a comma.
T2S_SECRET_KEY=

# Key for /v1/admin/* (sent as X-Admin-Key). Admin routes are disabled while this is empty.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
T2S_ADMIN_API_KEY=

# The settings below are optional and shown with their defaults. Uncomment to change one.
# (docker compose sets the three URLs itself, see docker-compose.yml.)

# Tenants, API keys and connections (SQLAlchemy URL).
# T2S_METADATA_URL=sqlite:///.t2s/metadata.db
# LangGraph checkpoints: memory://, sqlite:///path/to/file.db or postgresql://user:pass@host/db
# T2S_CHECKPOINT_URL=memory://
# Unset: rate limiting and cache live in the API process. Set it to share them between workers.
# T2S_REDIS_URL=redis://localhost:6379/0
# What the rate limiter does while Redis is unreachable: local, open or closed.
# T2S_RATE_LIMIT_FAIL_MODE=local
# T2S_RATE_LIMIT_PER_MINUTE=60
# T2S_MAX_CONCURRENT_QUERIES=8
# true lets tenants register sqlite/duckdb file paths. Single-tenant or development only.
# The Streamlit app turns this on for itself unless it is set here.
# T2S_ALLOW_FILE_DATABASES=false

# docker compose only: password of the bundled PostgreSQL. It is placed inside connection
# URLs, so use URL-safe characters, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
